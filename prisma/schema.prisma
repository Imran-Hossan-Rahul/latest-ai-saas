// Prisma schema for AI Sales Bot SaaS
// Multi-tenant: one User can have many Workspaces (businesses),
// each Workspace can have many connected Facebook Pages.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── NextAuth required models ────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?   // null for OAuth-only users
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts   Account[]
  sessions   Session[]
  workspaces WorkspaceMember[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Multi-tenant workspace ───────────────────────────────────────────────────

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Stripe subscription
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  stripePriceId        String?
  subscriptionStatus   String? // active | trialing | past_due | canceled

  members      WorkspaceMember[]
  facebookPages FacebookPage[]
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String   @default("owner") // owner | admin | viewer
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

// ─── Facebook integration ─────────────────────────────────────────────────────

model FacebookPage {
  id          String   @id @default(cuid())
  workspaceId String
  pageId      String   // Facebook's page ID
  pageName    String
  pictureUrl  String?
  about       String?  @db.Text
  // Access token is AES-256 encrypted at rest — never stored in plaintext
  encryptedAccessToken String @db.Text
  tokenExpiresAt       DateTime?
  isActive             Boolean  @default(true)
  webhookSubscribed    Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  agentConfig   AgentConfig?

  @@unique([workspaceId, pageId])
}

// ─── AI agent configuration per page ─────────────────────────────────────────

model AgentConfig {
  id             String @id @default(cuid())
  facebookPageId String @unique

  // Business context injected into the AI system prompt
  businessName    String
  businessType    String   // e.g. "clothing store", "electronics shop"
  productsInfo    String   @db.Text // free-form product/pricing info
  shippingInfo    String?  @db.Text
  faqs            String?  @db.Text // JSON array of {q, a} pairs
  dosList         String?  @db.Text // things the AI should always do
  dontsList       String?  @db.Text // things the AI must never do

  // Persona settings
  agentName       String   @default("Sales Assistant")
  tone            String   @default("friendly") // friendly | formal | casual
  salesStyle      String   @default("soft")     // soft | balanced | assertive
  language        String   @default("auto")     // auto | en | bn

  // Escalation rules
  escalateOnAnger Boolean @default(true)
  escalateKeywords String? @db.Text // comma-separated trigger words

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  facebookPage FacebookPage @relation(fields: [facebookPageId], references: [id], onDelete: Cascade)
}

// ─── Conversations & messages ─────────────────────────────────────────────────

model Conversation {
  id             String   @id @default(cuid())
  facebookPageId String
  // The Facebook PSID (Page-Scoped User ID) of the customer
  customerPsid   String
  customerName   String?
  customerPicUrl String?

  status    String   @default("ai")  // ai | human | closed
  tag       String?                  // hot_lead | closed | spam | null
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Summarized older context kept here to avoid bloating prompts
  contextSummary String? @db.Text

  facebookPage FacebookPage @relation(fields: [facebookPageId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@unique([facebookPageId, customerPsid])
  @@index([facebookPageId, updatedAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String   // user | assistant | system
  content        String   @db.Text
  // Raw Facebook mid for deduplication
  facebookMid    String?  @unique
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ─── Webhook event log (for debugging, message content redacted) ──────────────

model WebhookEvent {
  id          String   @id @default(cuid())
  pageId      String
  eventType   String   // messages | messaging_postbacks | etc.
  // We store only metadata, NOT message content, for privacy compliance
  senderPsid  String
  processed   Boolean  @default(false)
  error       String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([pageId, createdAt])
}
